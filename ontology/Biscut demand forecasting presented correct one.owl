<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/BiscuitDemandForecasting#"
     xml:base="http://www.semanticweb.org/BiscuitDemandForecasting"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:bdf="http://www.semanticweb.org/BiscuitDemandForecasting#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting">
        <dc:title>Biscuit Demand Forecasting Ontology</dc:title>
        <dc:creator>R.R.D.P Rathnayaka - D/DBA/23/0028 - General Sir John Kotelawala Defence University</dc:creator>
        <dc:date>2026</dc:date>
        <owl:versionInfo>3.0-Simplified</owl:versionInfo>
    </owl:Ontology>

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>

    <!-- ===== OBJECT PROPERTIES (simplified - no sub-properties, no functional/inverse functional) ===== -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasBrand">
        <rdfs:label>hasBrand</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#ManufacturingCompany"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasCompetitor">
        <rdfs:label>hasCompetitor</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#ManufacturingCompany"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#CompetitorCompany"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#operatesInProvince">
        <rdfs:label>operatesInProvince</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Province"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasEDAResult">
        <rdfs:label>hasEDAResult</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#EDAResult"/>
    </owl:ObjectProperty>

    <!-- Macroeconomic effect properties (flat - sub-properties removed) -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasNCPIEffect">
        <rdfs:label>hasNCPIEffect</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#NCPI"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasIPIEffect">
        <rdfs:label>hasIPIEffect</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#IPI"/>
    </owl:ObjectProperty>

    <!-- Seasonal event properties (flat - sub-properties removed) -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasPrimarySeasonalDriver">
        <rdfs:label>hasPrimarySeasonalDriver</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#SeasonalEvent"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasSecondarySeasonalDriver">
        <rdfs:label>hasSecondarySeasonalDriver</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#SeasonalEvent"/>
    </owl:ObjectProperty>

    <!-- CCF and lag properties (flat - sub-properties removed) -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasCCFFeature">
        <rdfs:label>hasCCFFeature</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#CCFLagFeature"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasLagWithCompetitor">
        <rdfs:label>hasLagWithCompetitor</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#CCFLagFeature"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasLagStructure">
        <rdfs:label>hasLagStructure</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#hasCompetitiveStanding">
        <rdfs:label>hasCompetitiveStanding</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#EDAResult"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#CompetitiveStanding"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#analysedInPeriod">
        <rdfs:label>analysedInPeriod</rdfs:label>
        <rdfs:range rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#AnalysisPeriod"/>
    </owl:ObjectProperty>

