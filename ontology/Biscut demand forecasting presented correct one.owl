        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7-month PACF effect only</bdf:lagInterpretation>
        <rdfs:label>BrandX_SP_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_UVA_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 3</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 3</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Short memory at lags 1 and 3</bdf:lagInterpretation>
        <rdfs:label>BrandX_UVA_Lag</rdfs:label>
    </owl:NamedIndividual>

    <!-- Own Lag Structures - Brand Y -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_WP_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 3, 4, 7</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 2</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-lag momentum. Opposite to Sub-brand X WP. Requires own-lag features in model.</bdf:lagInterpretation>
        <rdfs:label>BrandY_WP_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_CP_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 2</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-month own memory</bdf:lagInterpretation>
        <rdfs:label>BrandY_CP_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_Eastern_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 3, 9</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Short memory with extended PACF effects</bdf:lagInterpretation>
        <rdfs:label>BrandY_Eastern_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_NCP_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1-month own memory</bdf:lagInterpretation>
        <rdfs:label>BrandY_NCP_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_NWP_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No autocorrelation. Externally driven demand.</bdf:lagInterpretation>
        <rdfs:label>BrandY_NWP_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_Northern_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-month own memory</bdf:lagInterpretation>
        <rdfs:label>BrandY_Northern_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_SAB_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direct 4-month PACF effect only</bdf:lagInterpretation>
        <rdfs:label>BrandY_SAB_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_SP_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 8</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Short memory with seasonal lag 8</bdf:lagInterpretation>
        <rdfs:label>BrandY_SP_Lag</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_UVA_Lag">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#OwnLagStructure"/>
        <bdf:significantACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</bdf:significantACFLags>
        <bdf:significantPACFLags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1, 2, 4, 7</bdf:significantPACFLags>
        <bdf:lagInterpretation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Short memory with multiple lag influences</bdf:lagInterpretation>
        <rdfs:label>BrandY_UVA_Lag</rdfs:label>
    </owl:NamedIndividual>

    <!-- ===== DISJOINT CLASS DECLARATIONS (kept) ===== -->

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#SubBrandX"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#SubBrandY"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#WesternProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#CentralProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#SouthernProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#NorthernProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#NorthWesternProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#NorthCentralProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#UvaProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#SabaragamuwaProvince"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#EasternProvince"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#MarketLeader"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#StrongSecond"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#WeakSecond"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#Declining"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#NCPI"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#IPI"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- ===== DEFINED CLASSES (kept unchanged) ===== -->

    <owl:Class rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandWithNCPIInfluence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#hasEDAResult"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#hasNCPIEffect"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#NCPI"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>BrandWithNCPIInfluence</rdfs:label>
        <rdfs:comment>Any biscuit brand whose EDA result shows significant NCPI cross-correlation. Both Sub-brand X and Sub-brand Y qualify.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandWithIPIInfluence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#hasEDAResult"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#hasIPIEffect"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#IPI"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>BrandWithIPIInfluence</rdfs:label>
        <rdfs:comment>Any biscuit brand whose EDA result shows significant IPI cross-correlation. Only Sub-brand Y qualifies.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#CompetitorLedBrand">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BiscuitBrand"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#hasEDAResult"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#hasLagWithCompetitor"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#CCFLagFeature"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>CompetitorLedBrand</rdfs:label>
        <rdfs:comment>Any biscuit brand that has at least one province where Competitor A sales lead its own demand.</rdfs:comment>
    </owl:Class>

</rdf:RDF>
