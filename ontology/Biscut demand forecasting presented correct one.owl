    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_EDA">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#SubBrandY_EDAResult"/>
        <bdf:edaFinding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCPI predicts demand in WP lag3, Northern lag3, SP lags9and6. IPI predicts demand in CP lag7, NCP lags3and8, Northern lags6and3and9, Eastern lags-5and-1, SAB lags4and8, SP lags9and5. Competitor A leads demand in CP lag2 negative, UVA lag5. Sub-brand Y leads Competitor A in WP, Northern, NWP.</bdf:edaFinding>
        <bdf:hasCompetitiveStanding rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Standing_Declining"/>
        <bdf:hasNCPIEffect rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#NCPI_Instance"/>
        <bdf:hasIPIEffect rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#IPI_Instance"/>
        <bdf:hasPrimarySeasonalDriver rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Event_SinhalaTamilNewYear"/>
        <bdf:hasSecondarySeasonalDriver rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Event_Christmas"/>
        <bdf:hasSecondarySeasonalDriver rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Event_Ramadan"/>
        <bdf:hasSecondarySeasonalDriver rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Event_Deepavali"/>
        <bdf:analysedInPeriod rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#PostCrisis_Period"/>
        <bdf:hasCCFFeature rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_WP_NCPI_Lag3"/>
        <bdf:hasCCFFeature rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandY_Northern_NCPI_Lag3"/>
