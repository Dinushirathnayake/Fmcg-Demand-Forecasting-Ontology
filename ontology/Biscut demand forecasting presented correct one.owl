    <!-- SubBrandX_EDAResult and SubBrandY_EDAResult: simple subclasses, hasValue restrictions removed -->
    <owl:Class rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#SubBrandX_EDAResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#EDAResult"/>
        <rdfs:label>SubBrandX_EDAResult</rdfs:label>
        <rdfs:comment>EDA result for Sub-brand X. StrongSecond standing, NCPI-influenced, primary driver SinhalaTamilNewYear.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#SubBrandY_EDAResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#EDAResult"/>
        <rdfs:label>SubBrandY_EDAResult</rdfs:label>
        <rdfs:comment>EDA result for Sub-brand Y. Declining standing, NCPI and IPI influenced, primary driver SinhalaTamilNewYear.</rdfs:comment>
    </owl:Class>

