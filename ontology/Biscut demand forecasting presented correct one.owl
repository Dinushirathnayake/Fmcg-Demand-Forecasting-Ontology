    <!-- EDA Results - Brand X -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_EDA">
        <rdf:type rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#SubBrandX_EDAResult"/>
        <bdf:edaFinding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCPI predicts demand in WP lag6, CP lag1, NCP lag5, Northern lag9. IPI excluded from all provinces. Competitor A leads demand in Eastern lag2, NWP lag4, SAB lag1, SP lag2, UVA lag5. WP Sub-brand X leads Competitor A at lag1.</bdf:edaFinding>
        <bdf:hasCompetitiveStanding rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Standing_StrongSecond"/>
        <bdf:hasNCPIEffect rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#NCPI_Instance"/>
        <bdf:hasPrimarySeasonalDriver rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Event_SinhalaTamilNewYear"/>
        <bdf:hasSecondarySeasonalDriver rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Event_Christmas"/>
        <bdf:hasSecondarySeasonalDriver rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#Event_Deepavali"/>
        <bdf:analysedInPeriod rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#PostCrisis_Period"/>
        <bdf:hasCCFFeature rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_WP_NCPI_Lag6"/>
        <bdf:hasCCFFeature rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_CP_NCPI_Lag1"/>
        <bdf:hasCCFFeature rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_NCP_NCPI_Lag5"/>
        <bdf:hasCCFFeature rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_Northern_NCPI_Lag9"/>
        <bdf:hasLagWithCompetitor rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_Eastern_CompA_Lag2"/>
        <bdf:hasLagWithCompetitor rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_NWP_CompA_Lag4"/>
        <bdf:hasLagWithCompetitor rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_SAB_CompA_Lag1"/>
        <bdf:hasLagWithCompetitor rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_SP_CompA_Lag2"/>
        <bdf:hasLagWithCompetitor rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_UVA_CompA_Lag5"/>
        <bdf:hasLagStructure rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_WP_Lag"/>
        <bdf:hasLagStructure rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_CP_Lag"/>
        <bdf:hasLagStructure rdf:resource="http://www.semanticweb.org/BiscuitDemandForecasting#BrandX_Eastern_Lag"/>
